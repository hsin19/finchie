{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "types": [
      "$app/types",
      "node"
    ]
  },
  "include": [
    "src",
    "vite.config.ts",
    "icons.ts",
    "eslint.config.js"
  ],
  // The service worker has its own (src/service-worker/tsconfig.json): a worker's globals, not a page's.
  "exclude": ["src/service-worker"]
}
